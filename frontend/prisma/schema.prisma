generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── NextAuth required models ─────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts            Account[]
  sessions            Session[]
  botProfile          BotProfile?
  meetings            Meeting[]
  usageRecords        UsageRecord[]
  calendarConnections CalendarConnection[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App models ───────────────────────────────────────────

model BotProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  name         String
  persona      String
  voice        String           @default("FEMALE")
  responseMode String           @default("WAKE_WORD_ONLY")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    GlobalDocument[]
}

model GlobalDocument {
  id           String     @id @default(cuid())
  botProfileId String
  name         String
  fileName     String
  fileType     String
  fileSize     Int
  fileUrl      String
  createdAt    DateTime   @default(now())
  botProfile   BotProfile @relation(fields: [botProfileId], references: [id], onDelete: Cascade)
}

model Meeting {
  id              String           @id @default(cuid())
  userId          String
  title           String
  joinUrl         String
  platform        String           @default("Manual")
  scheduledTime   DateTime
  endTime         DateTime?
  status          String           @default("SCHEDULED")
  durationMinutes Int?
  botJoined       Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  override        MeetingOverride?
  report          Report?
  liveSession     LiveSession?
  usageRecords    UsageRecord[]
}

model MeetingOverride {
  id                   String            @id @default(cuid())
  meetingId            String            @unique
  personaOverride      String?
  voiceOverride        String?
  responseModeOverride String?
  meeting              Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  documents            MeetingDocument[]
}

model MeetingDocument {
  id                String          @id @default(cuid())
  meetingOverrideId String
  name              String
  fileName          String
  fileType          String
  fileSize          Int
  fileUrl           String
  createdAt         DateTime        @default(now())
  meetingOverride   MeetingOverride @relation(fields: [meetingOverrideId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  meetingId   String   @unique
  summary     String
  actionItems String   @default("[]")
  pdfUrl      String   @default("")
  wordUrl     String   @default("")
  createdAt   DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  meetingId    String
  meetingTitle String
  minutesUsed  Int
  usedAt       DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model CalendarConnection {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  connectedAt DateTime @default(now())
  autoJoinAll Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id        String   @id @default(cuid())
  meetingId String   @unique
  status    String   @default("LISTENING")
  startedAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}
